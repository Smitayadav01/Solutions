# ─────────────────────────────────────────────────────────────
# Contact form email settings
#
# 1. For the LIVE site: add each line below in
#    Vercel → Project → Settings → Environment Variables (tick Production),
#    then Deployments → Redeploy.
# 2. For LOCALHOST: copy this file to a new file named ".env" (same folder),
#    put your real App Password in it, and run `npm run dev`.
#    .env is never uploaded to GitHub. Never put the real password in THIS file.
# ─────────────────────────────────────────────────────────────

# Who receives enquiries (comma-separated for more than one)
CONTACT_TO=anitasolutions.tech@gmail.com

# Gmail account that sends the enquiry emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=anitasolutions.tech@gmail.com

# 16-character Google App Password from myaccount.google.com/apppasswords
# (NOT your normal Gmail password). Spaces are OK.
SMTP_PASS=

# Optional
MAIL_FROM=
